SECRET_KEY=change_me_with_a_long_random_secret

# Frontend URL used to build password reset links.
# In production this must point to your real app domain.
FRONTEND_BASE_URL=https://www.klinip.cl

# Email provider: auto | resend | smtp
# - auto: uses Resend when RESEND_API_KEY is present, otherwise SMTP
EMAIL_PROVIDER=auto
EMAIL_API_TIMEOUT=20
APP_DISPLAY_NAME=Klinip
EMAIL_LOGO_URL=https://www.klinip.cl/icons/android-chrome-192x192.png

# Resend API configuration (recommended on Railway Hobby)
# Requires verified sending domain in Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
MAIL_FROM_SECURITY=Klinip Seguridad <seguridad@klinip.cl>
MAIL_FROM_NOTIFICATIONS=Klinip Notificaciones <notificaciones@klinip.cl>
# Optional aliases also accepted by the backend:
# MAIL_FROM=Klinip <hola@klinip.cl>
# RESEND_FROM=Klinip <hola@klinip.cl>
# RESEND_FROM_SECURITY=Klinip Seguridad <seguridad@klinip.cl>
# RESEND_FROM_NOTIFICATIONS=Klinip Notificaciones <notificaciones@klinip.cl>

# Zoho SMTP configuration (optional fallback / Pro+ plans)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_TIMEOUT=25
SMTP_USER=hola@klinip.cl
SMTP_PASS=zoho_app_password_or_smtp_password
SMTP_FROM_SECURITY=Klinip Seguridad <seguridad@klinip.cl>
SMTP_FROM_NOTIFICATIONS=Klinip Notificaciones <notificaciones@klinip.cl>
# Optional global fallback:
# SMTP_FROM=Klinip <hola@klinip.cl>
# Si tu cuenta es regional de Zoho, usa el host correspondiente:
# EU: smtp.zoho.eu | IN: smtp.zoho.in | AU: smtp.zoho.com.au

# Support mailbox target (can be alias)
# Preferred split targets:
EMAIL_TO_SUPPORT=soporte@klinip.cl
EMAIL_TO_PRIVACY=privacidad@klinip.cl
# Legacy fallback:
SUPPORT_EMAIL=soporte@klinip.cl

# Existing push config (optional for password reset flow)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:hola@klinip.cl

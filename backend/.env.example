SECRET_KEY=change_me_with_a_long_random_secret

# Frontend URL used to build password reset links.
# In production this must point to your real app domain.
FRONTEND_BASE_URL=http://localhost:5173

# SMTP configuration for password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=Klinip <no-reply@klinip.app>

# Existing push config (optional for password reset flow)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@klinip.app
